# Secrets and local overrides
.env
.env.*
!.env.example
*.local
secrets/
!secrets/.gitkeep
kubernetes/base/secret.local.yaml

# Build and test artifacts
/bin/
/.cache/
coverage.out
coverage.html
/frontend/node_modules/
/frontend/dist/

# Runtime data (never commit household data or receipts)
/data/
/storage/receipts/*
!/storage/receipts/.gitkeep
/backups/*
!/backups/.gitkeep

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store

# Terraform local state
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# Lokale Schwaerzungsregeln fuer den oeffentlichen Export (HF-0145)
redactions.local.txt
