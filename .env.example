# Copy to .env and replace every value. Never commit .env.
HOMEFLOW_ENV=development
HOMEFLOW_LISTEN_ADDR=:8080
HOMEFLOW_RECEIPT_STORAGE=./storage/receipts
# false is permitted only for loopback/local HTTP; remote access will require HTTPS and true.
HOMEFLOW_COOKIE_SECURE=false
HOMEFLOW_UID=1000
HOMEFLOW_GID=1000
POSTGRES_DB=homeflow
POSTGRES_USER=homeflow
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
HOMEFLOW_DATABASE_URL=postgres://homeflow:replace-with-a-long-random-local-password@127.0.0.1:5432/homeflow?sslmode=disable

# Used only when an empty database is bootstrapped. Exactly two accounts are created.
HOMEFLOW_USER1_USERNAME=person1
HOMEFLOW_USER1_DISPLAY_NAME=Person 1
HOMEFLOW_USER1_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters
HOMEFLOW_USER2_USERNAME=person2
HOMEFLOW_USER2_DISPLAY_NAME=Person 2
HOMEFLOW_USER2_PASSWORD=replace-with-another-strong-password-of-at-least-12-characters
